# CampusAtlas Server Environment Configuration (Safe Placeholders)

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client URL (for CORS validation in development)
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
# Example: mongodb://localhost:27017/campusatlas OR mongodb+srv://<user>:<password>@cluster.mongodb.net/campusatlas
MONGODB_URI=mongodb://localhost:27017/campusatlas

# Authentication Secret (Minimum 32 random characters for JWT signing)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long

# Gemini API Configuration (Official @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Initial Moderator / Admin Access (Comma-separated normalized emails)
ADMIN_EMAILS=moderator@campusatlas.edu,admin@campusatlas.edu
